                dialogueText: No... I shouldn't.
                responses:
                - responseText: ...
                  nextNode:
                    dialogueText: 
                    responses: []
                  ending: 0
              ending: 0
            - responseText: Steal it
              nextNode:
                dialogueText: No one will notice... right?
                responses:
                - responseText: (Cake Get)
